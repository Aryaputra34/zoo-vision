# Python
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
.env

# Local operator config (camera URLs with passwords, API keys), including renamed copies such as
# cameras.yaml.bak: only the *.example files and rules/ are tracked
services/engine/configs/*
!services/engine/configs/*.example
!services/engine/configs/rules/

# Model weights: fetched by tools/fetch_models.py; only the manifest is tracked
*.pt
*.onnx
*.engine
*.xml
*.bin
yolo11s_openvino_model/
services/engine/models/*
!services/engine/models/manifest.json

# Videos and images (small test videos go through Git LFS, see .gitattributes)
*.mp4
*.jpg

# Runtime output
snapshots/
recordings/
logs/
deploy/data/

# Local binaries and SDKs (deployment uses the bluenviron/mediamtx image)
/mediamtx.exe
/mediamtx.yml
/mediamtx/
metavms-server_plugin_sdk-*/

# Personal experiments
scratch/
