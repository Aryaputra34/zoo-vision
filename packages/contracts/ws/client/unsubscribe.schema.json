{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unsubscribe",
  "description": "Leave the status room.",
  "type": "object",
  "properties": {
    "rooms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "const": "status"
          },
          {
            "type": "string",
            "pattern": "^camera:[a-z][a-z0-9_]{2,63}$"
          }
        ]
      }
    }
  },
  "required": [
    "rooms"
  ],
  "additionalProperties": false
}
