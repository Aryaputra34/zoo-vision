{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Detection",
  "description": "Settings types shared by the detection use cases.",
  "$defs": {
    "ModelName": {
      "title": "ModelName",
      "type": "string",
      "pattern": "^[\\w.-]+\\.(onnx|pt|engine)$"
    },
    "ModelId": {
      "title": "ModelId",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "ImageSize": {
      "title": "ImageSize",
      "description": "Inference size: one integer for a square, or [height, width].",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 32,
          "maximum": 4096
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 32,
              "maximum": 4096
            },
            {
              "type": "integer",
              "minimum": 32,
              "maximum": 4096
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "ConfidenceThreshold": {
      "title": "ConfidenceThreshold",
      "type": "number",
      "minimum": 0.01,
      "maximum": 1
    },
    "NxBookmark": {
      "title": "NxBookmark",
      "type": "object",
      "properties": {
        "tag": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        }
      },
      "additionalProperties": false
    }
  }
}
