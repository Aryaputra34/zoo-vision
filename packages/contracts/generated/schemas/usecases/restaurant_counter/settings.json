{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RestaurantCounterSettings",
  "type": "object",
  "properties": {
    "model_name": {
      "default": "yolo11s.onnx",
      "x-minRole": "SUPERADMIN",
      "title": "ModelName",
      "type": "string",
      "pattern": "^[\\w.-]+\\.(onnx|pt|engine)$"
    },
    "model_id": {
      "description": "AiModel id. When set, the camera runs this registry model instead of model_name.",
      "x-minRole": "SUPERADMIN",
      "title": "ModelId",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "imgsz": {
      "default": 1920,
      "x-minRole": "SUPERADMIN",
      "title": "ImageSize",
      "description": "Inference size: one integer for a square, or [height, width].",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 32,
          "maximum": 4096
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 32,
              "maximum": 4096
            },
            {
              "type": "integer",
              "minimum": 32,
              "maximum": 4096
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "confidence_threshold": {
      "default": 0.2,
      "title": "ConfidenceThreshold",
      "type": "number",
      "minimum": 0.01,
      "maximum": 1
    },
    "mode": {
      "enum": [
        "area_occupancy",
        "tripwire"
      ],
      "default": "area_occupancy"
    },
    "deduplication_enabled": {
      "type": "boolean",
      "default": true,
      "x-minRole": "SUPERADMIN"
    },
    "iou_threshold": {
      "type": "number",
      "default": 0.45,
      "x-minRole": "SUPERADMIN"
    },
    "containment_threshold": {
      "type": "number",
      "default": 0.65,
      "x-minRole": "SUPERADMIN"
    },
    "tracking_enabled": {
      "type": "boolean",
      "default": true,
      "x-minRole": "SUPERADMIN"
    },
    "lost_track_buffer": {
      "type": "integer",
      "default": 30,
      "x-minRole": "SUPERADMIN"
    },
    "smoothing_frames": {
      "type": "integer",
      "default": 5,
      "x-minRole": "SUPERADMIN"
    },
    "show_boxes": {
      "type": "boolean",
      "default": true
    },
    "show_labels": {
      "type": "boolean",
      "default": true
    },
    "dining_zone": {
      "title": "Polygon",
      "type": "array",
      "items": {
        "title": "Point",
        "type": "array",
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "prefixItems": [
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 3,
      "x-geometry": "polygon"
    },
    "tripwire": {
      "default": {
        "start": [
          0.1,
          0.5
        ],
        "end": [
          0.9,
          0.5
        ]
      },
      "title": "Line",
      "type": "object",
      "properties": {
        "start": {
          "title": "Point",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "end": {
          "title": "Point",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "x-geometry": "line"
    },
    "shadow_zone": {
      "title": "ShadowZone",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "start": {
          "default": [
            1,
            0.48
          ],
          "title": "Point",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "end": {
          "default": [
            0.82,
            0.17
          ],
          "title": "Point",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "confidence_threshold": {
          "default": 0.11,
          "title": "ConfidenceThreshold",
          "type": "number",
          "minimum": 0.01,
          "maximum": 1
        }
      },
      "additionalProperties": false,
      "default": {},
      "x-geometry": "line"
    },
    "max_capacity": {
      "type": "integer",
      "default": 60
    },
    "warning_capacity": {
      "type": "integer",
      "default": 45
    },
    "smoothing_window_sec": {
      "type": "number",
      "default": 4
    },
    "debounce_alert_sec": {
      "type": "integer",
      "default": 60
    },
    "table_monitoring": {
      "title": "TableMonitoring",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "show_overlay": {
          "type": "boolean",
          "default": true
        },
        "show_labels": {
          "type": "boolean",
          "default": true
        },
        "show_summary_card": {
          "type": "boolean",
          "default": false
        },
        "dwell_time": {
          "default": {},
          "title": "DwellTime",
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "min_occupied_sec": {
              "type": "number",
              "default": 0,
              "minimum": 0
            },
            "empty_debounce_sec": {
              "type": "number",
              "default": 15,
              "minimum": 0
            },
            "alert_dwell_sec": {
              "type": "number",
              "default": 3600,
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "tables": {
          "title": "TableList",
          "type": "array",
          "items": {
            "title": "Table",
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,32}$"
              },
              "name": {
                "type": "string",
                "default": ""
              },
              "capacity": {
                "type": "integer",
                "default": 4,
                "minimum": 1
              },
              "polygon": {
                "title": "Polygon",
                "type": "array",
                "items": {
                  "title": "Point",
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 3,
                "x-geometry": "polygon"
              },
              "confidence_threshold": {
                "title": "ConfidenceThreshold",
                "type": "number",
                "minimum": 0.01,
                "maximum": 1
              },
              "min_occupied_sec": {
                "type": "number",
                "minimum": 0
              },
              "empty_debounce_sec": {
                "type": "number",
                "minimum": 0
              },
              "track_dwell_time": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "polygon"
            ],
            "additionalProperties": false
          },
          "x-geometry": "polygon-list"
        }
      },
      "additionalProperties": false
    },
    "nx_bookmark": {
      "title": "NxBookmark",
      "type": "object",
      "properties": {
        "tag": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
