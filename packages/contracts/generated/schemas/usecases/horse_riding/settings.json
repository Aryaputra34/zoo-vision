{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HorseRidingSettings",
  "type": "object",
  "properties": {
    "model_name": {
      "default": "yolo11m.pt",
      "x-minRole": "SUPERADMIN",
      "title": "ModelName",
      "type": "string",
      "pattern": "^[\\w.-]+\\.(onnx|pt|engine)$"
    },
    "model_id": {
      "description": "AiModel id. When set, the camera runs this registry model instead of model_name.",
      "x-minRole": "SUPERADMIN",
      "title": "ModelId",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "imgsz": {
      "default": 640,
      "x-minRole": "SUPERADMIN",
      "title": "ImageSize",
      "description": "Inference size: one integer for a square, or [height, width].",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 32,
          "maximum": 4096
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 32,
              "maximum": 4096
            },
            {
              "type": "integer",
              "minimum": 32,
              "maximum": 4096
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "confidence_threshold": {
      "default": 0.35,
      "title": "ConfidenceThreshold",
      "type": "number",
      "minimum": 0.01,
      "maximum": 1
    },
    "track_horses_only": {
      "type": "boolean",
      "default": true,
      "x-minRole": "SUPERADMIN"
    },
    "track_activation_thresh": {
      "type": "number",
      "default": 0.25,
      "x-minRole": "SUPERADMIN"
    },
    "lost_track_buffer": {
      "type": "integer",
      "default": 60,
      "x-minRole": "SUPERADMIN"
    },
    "matching_thresh": {
      "type": "number",
      "default": 0.7,
      "x-minRole": "SUPERADMIN"
    },
    "frame_rate": {
      "type": "integer",
      "default": 15,
      "minimum": 1,
      "maximum": 60,
      "x-minRole": "SUPERADMIN"
    },
    "smoothing_frames": {
      "type": "integer",
      "default": 4,
      "x-minRole": "SUPERADMIN"
    },
    "tripwire": {
      "title": "Tripwire",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "start": {
          "default": [
            0.2,
            0.6
          ],
          "title": "Point",
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "end": {
          "default": [
            0.8,
            0.6
          ],
          "title": "Point",
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false,
      "default": {},
      "x-geometry": "line"
    },
    "roi_polygon": {
      "title": "Polygon",
      "type": "array",
      "items": {
        "title": "Point",
        "type": "array",
        "prefixItems": [
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 3,
      "x-geometry": "polygon"
    },
    "display_label": {
      "type": "string",
      "default": "Horse"
    },
    "display_label_plural": {
      "type": "string"
    },
    "attraction_title": {
      "type": "string"
    },
    "show_boxes": {
      "type": "boolean",
      "default": true
    },
    "show_labels": {
      "type": "boolean",
      "default": true
    },
    "show_traces": {
      "type": "boolean",
      "default": true
    },
    "trace_length": {
      "type": "integer",
      "default": 45
    },
    "debounce_alert_sec": {
      "type": "integer",
      "default": 15
    },
    "nx_bookmark": {
      "title": "NxBookmark",
      "type": "object",
      "properties": {
        "tag": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
