{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RestaurantTableSettings",
  "type": "object",
  "properties": {
    "model_name": {
      "default": "yolo11s.onnx",
      "x-minRole": "SUPERADMIN",
      "title": "ModelName",
      "type": "string",
      "pattern": "^[\\w.-]+\\.(onnx|pt|engine)$"
    },
    "imgsz": {
      "default": 1920,
      "x-minRole": "SUPERADMIN",
      "title": "ImageSize",
      "description": "Inference size: one integer for a square, or [height, width].",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 32,
          "maximum": 4096
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 32,
              "maximum": 4096
            },
            {
              "type": "integer",
              "minimum": 32,
              "maximum": 4096
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "confidence_threshold": {
      "$ref": "#/properties/tables/items/properties/confidence_threshold",
      "default": 0.2
    },
    "deduplication_enabled": {
      "type": "boolean",
      "default": true,
      "x-minRole": "SUPERADMIN"
    },
    "iou_threshold": {
      "type": "number",
      "default": 0.45,
      "x-minRole": "SUPERADMIN"
    },
    "containment_threshold": {
      "type": "number",
      "default": 0.65,
      "x-minRole": "SUPERADMIN"
    },
    "show_person_boxes": {
      "type": "boolean",
      "default": false
    },
    "show_person_labels": {
      "type": "boolean",
      "default": false
    },
    "show_overlay": {
      "type": "boolean",
      "default": true
    },
    "show_labels": {
      "type": "boolean",
      "default": true
    },
    "show_summary_card": {
      "type": "boolean",
      "default": true
    },
    "dwell_time": {
      "default": {},
      "title": "DwellTime",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "min_occupied_sec": {
          "type": "number",
          "default": 0,
          "minimum": 0
        },
        "empty_debounce_sec": {
          "type": "number",
          "default": 15,
          "minimum": 0
        },
        "alert_dwell_sec": {
          "type": "number",
          "default": 3600,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "tables": {
      "minItems": 1,
      "title": "TableList",
      "type": "array",
      "items": {
        "title": "Table",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$"
          },
          "name": {
            "type": "string",
            "default": ""
          },
          "capacity": {
            "type": "integer",
            "default": 4,
            "minimum": 1
          },
          "polygon": {
            "title": "Polygon",
            "type": "array",
            "items": {
              "title": "Point",
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 3,
            "x-geometry": "polygon"
          },
          "confidence_threshold": {
            "title": "ConfidenceThreshold",
            "type": "number",
            "minimum": 0.01,
            "maximum": 1
          },
          "min_occupied_sec": {
            "type": "number",
            "minimum": 0
          },
          "empty_debounce_sec": {
            "type": "number",
            "minimum": 0
          },
          "track_dwell_time": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "polygon"
        ],
        "additionalProperties": false
      },
      "x-geometry": "polygon-list"
    },
    "nx_bookmark": {
      "title": "NxBookmark",
      "type": "object",
      "properties": {
        "tag": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "tables"
  ],
  "additionalProperties": false
}
