{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RestaurantTableLive",
  "description": "What the pipeline reports in cam:{id}:status `live`. Every field is optional and extra fields are allowed, so a pipeline can add values without a new schema version.",
  "type": "object",
  "properties": {
    "totalTables": {
      "type": "integer",
      "minimum": 0
    },
    "occupiedTables": {
      "type": "integer",
      "minimum": 0
    },
    "vacantTables": {
      "type": "integer",
      "minimum": 0
    },
    "occupancyRatePct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "dwellTimeEnabled": {
      "type": "boolean"
    },
    "tables": {
      "type": "array",
      "items": {
        "title": "TableLive",
        "description": "One table in a restaurant live status.",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "isOccupied": {
            "type": "boolean"
          },
          "personCount": {
            "type": "integer",
            "minimum": 0
          },
          "capacity": {
            "type": "integer",
            "minimum": 0
          },
          "dwellSec": {
            "type": "integer",
            "minimum": 0
          },
          "trackDwellTime": {
            "type": "boolean"
          },
          "totalSessions": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "isOccupied",
          "personCount",
          "capacity",
          "dwellSec",
          "trackDwellTime",
          "totalSessions"
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
