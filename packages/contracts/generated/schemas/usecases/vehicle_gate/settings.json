{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VehicleGateSettings",
  "type": "object",
  "properties": {
    "model_name": {
      "default": "yolo26s.onnx",
      "x-minRole": "SUPERADMIN",
      "title": "ModelName",
      "type": "string",
      "pattern": "^[\\w.-]+\\.(onnx|pt|engine)$"
    },
    "model_id": {
      "description": "AiModel id. When set, the camera runs this registry model instead of model_name.",
      "x-minRole": "SUPERADMIN",
      "title": "ModelId",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "imgsz": {
      "default": 640,
      "x-minRole": "SUPERADMIN",
      "title": "ImageSize",
      "description": "Inference size: one integer for a square, or [height, width].",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 32,
          "maximum": 4096
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 32,
              "maximum": 4096
            },
            {
              "type": "integer",
              "minimum": 32,
              "maximum": 4096
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "confidence_threshold": {
      "default": 0.3,
      "title": "ConfidenceThreshold",
      "type": "number",
      "minimum": 0.01,
      "maximum": 1
    },
    "tripwire": {
      "default": {
        "start": [
          0.76,
          0.58
        ],
        "end": [
          0.05,
          0.43
        ]
      },
      "title": "Line",
      "type": "object",
      "properties": {
        "start": {
          "title": "Point",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "end": {
          "title": "Point",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "x-geometry": "line"
    },
    "roi_polygon": {
      "title": "Polygon",
      "type": "array",
      "items": {
        "title": "Point",
        "type": "array",
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "prefixItems": [
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 3,
      "x-geometry": "polygon"
    },
    "track_activation_thresh": {
      "type": "number",
      "default": 0.25,
      "x-minRole": "SUPERADMIN"
    },
    "lost_track_buffer": {
      "type": "integer",
      "default": 75,
      "x-minRole": "SUPERADMIN"
    },
    "matching_thresh": {
      "type": "number",
      "default": 0.7,
      "x-minRole": "SUPERADMIN"
    },
    "frame_rate": {
      "type": "integer",
      "default": 15,
      "x-minRole": "SUPERADMIN"
    },
    "anpr": {
      "title": "Anpr",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "model_path": {
          "type": "string",
          "default": "models/license_plate_detector.onnx"
        },
        "min_plate_confidence": {
          "type": "number",
          "default": 0.25
        }
      },
      "additionalProperties": false,
      "default": {},
      "x-minRole": "SUPERADMIN"
    },
    "nx_bookmark": {
      "title": "NxBookmark",
      "type": "object",
      "properties": {
        "tag": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
