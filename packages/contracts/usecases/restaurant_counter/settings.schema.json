{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RestaurantCounterSettings",
  "type": "object",
  "properties": {
    "model_name": {
      "$ref": "../../common/detection.schema.json#/$defs/ModelName",
      "default": "yolo11s.onnx",
      "x-minRole": "SUPERADMIN"
    },
    "model_id": {
      "$ref": "../../common/detection.schema.json#/$defs/ModelId",
      "description": "AiModel id. When set, the camera runs this registry model instead of model_name.",
      "x-minRole": "SUPERADMIN"
    },
    "imgsz": {
      "$ref": "../../common/detection.schema.json#/$defs/ImageSize",
      "default": 1920,
      "x-minRole": "SUPERADMIN"
    },
    "confidence_threshold": {
      "$ref": "../../common/detection.schema.json#/$defs/ConfidenceThreshold",
      "default": 0.2
    },
    "mode": {
      "enum": [
        "area_occupancy",
        "tripwire"
      ],
      "default": "area_occupancy"
    },
    "deduplication_enabled": {
      "type": "boolean",
      "default": true,
      "x-minRole": "SUPERADMIN"
    },
    "iou_threshold": {
      "type": "number",
      "default": 0.45,
      "x-minRole": "SUPERADMIN"
    },
    "containment_threshold": {
      "type": "number",
      "default": 0.65,
      "x-minRole": "SUPERADMIN"
    },
    "tracking_enabled": {
      "type": "boolean",
      "default": true,
      "x-minRole": "SUPERADMIN"
    },
    "lost_track_buffer": {
      "type": "integer",
      "default": 30,
      "x-minRole": "SUPERADMIN"
    },
    "smoothing_frames": {
      "type": "integer",
      "default": 5,
      "x-minRole": "SUPERADMIN"
    },
    "show_boxes": {
      "type": "boolean",
      "default": true
    },
    "show_labels": {
      "type": "boolean",
      "default": true
    },
    "dining_zone": {
      "$ref": "../../common/geometry.schema.json#/$defs/Polygon"
    },
    "tripwire": {
      "$ref": "../../common/geometry.schema.json#/$defs/Line",
      "default": {
        "start": [
          0.1,
          0.5
        ],
        "end": [
          0.9,
          0.5
        ]
      }
    },
    "shadow_zone": {
      "title": "ShadowZone",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "start": {
          "$ref": "../../common/geometry.schema.json#/$defs/Point",
          "default": [
            1,
            0.48
          ]
        },
        "end": {
          "$ref": "../../common/geometry.schema.json#/$defs/Point",
          "default": [
            0.82,
            0.17
          ]
        },
        "confidence_threshold": {
          "$ref": "../../common/detection.schema.json#/$defs/ConfidenceThreshold",
          "default": 0.11
        }
      },
      "additionalProperties": false,
      "default": {},
      "x-geometry": "line"
    },
    "max_capacity": {
      "type": "integer",
      "default": 60
    },
    "warning_capacity": {
      "type": "integer",
      "default": 45
    },
    "smoothing_window_sec": {
      "type": "number",
      "default": 4
    },
    "debounce_alert_sec": {
      "type": "integer",
      "default": 60
    },
    "table_monitoring": {
      "title": "TableMonitoring",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "show_overlay": {
          "type": "boolean",
          "default": true
        },
        "show_labels": {
          "type": "boolean",
          "default": true
        },
        "show_summary_card": {
          "type": "boolean",
          "default": false
        },
        "dwell_time": {
          "$ref": "../../common/tables.schema.json#/$defs/DwellTime",
          "default": {}
        },
        "tables": {
          "$ref": "../../common/tables.schema.json#/$defs/TableList"
        }
      },
      "additionalProperties": false
    },
    "nx_bookmark": {
      "$ref": "../../common/detection.schema.json#/$defs/NxBookmark"
    }
  },
  "additionalProperties": false
}
