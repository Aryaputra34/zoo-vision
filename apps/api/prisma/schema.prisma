// The URL lives in prisma.config.ts (DATABASE_MIGRATE_URL, owner role, CLI only).
// The running API connects through @prisma/adapter-pg with DATABASE_URL (zoo_api role).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  MANAGER
  USER
}

enum SourceType {
  RTSP
  MEDIAMTX
  NX
  FILE
}

enum StreamChoice {
  MAIN
  SUB
}

enum LoginResult {
  SUCCESS
  WRONG_PASSWORD
  DISABLED
  LOCKED
  RATE_LIMITED
  LOGOUT
}

enum Severity {
  info
  warning
  critical
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  apiTokens    ApiToken[]
}

model ApiToken {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  prefix      String
  tokenHash   String    @unique
  role        Role
  createdById String    @db.Uuid
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt  DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  time        DateTime @default(now()) @db.Timestamptz(3)
  actorType   String // user|token
  actorId     String
  actorName   String
  action      String
  entity      String
  entityId    String?
  before      Json?
  after       Json?
  ip          String?
  /// the change was to a camera with `auditCamera` set (before or after it)
  auditCamera Boolean  @default(false)

  @@index([entity, entityId, time])
  @@index([time])
}

model LoginLog {
  id        BigInt      @id @default(autoincrement())
  time      DateTime    @default(now()) @db.Timestamptz(3)
  username  String // as typed
  userId    String?     @db.Uuid
  result    LoginResult
  ip        String?
  userAgent String?

  @@index([time])
}

model Camera {
  id                    String                @id // slug
  name                  String
  area                  String?
  useCase               String
  enabled               Boolean               @default(true)
  sourceType            SourceType
  mainStreamUrlEnc      String
  subStreamUrlEnc       String?
  targetFps             Int                   @default(5)
  engineGroup           String                @default("default")
  auditCamera           Boolean               @default(false)
  recordingEnabled      Boolean               @default(true)
  recordingStream       StreamChoice          @default(MAIN)
  inferenceStream       StreamChoice          @default(MAIN)
  retentionDays         Int? // null = site default
  evidenceRetentionDays Int? // null = site default
  clipBeforeSec         Int                   @default(15)
  clipAfterSec          Int                   @default(15)
  nxCameraId            String?
  activeVersion         Int
  firstSeenAt           DateTime?             @db.Timestamptz(3) // first time the engine's status key was seen
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)
  versions              CameraConfigVersion[]
  events                Event[]
  intervals             Interval[]
  metrics               Metric[]
}

model CameraConfigVersion {
  cameraId      String
  camera        Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  version       Int
  useCase       String
  settings      Json
  schemaVersion Int
  authorType    String
  authorId      String
  authorName    String
  note          String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@id([cameraId, version])
}

model Event {
  id            String    @id // evt_…
  time          DateTime  @db.Timestamptz(3)
  cameraId      String?
  camera        Camera?   @relation(fields: [cameraId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  useCase       String
  type          String
  severity      Severity
  configVersion Int?
  schemaVersion Int
  snapshotPath  String?
  data          Json
  ingestedAt    DateTime  @default(now()) @db.Timestamptz(3)
  evidence      Evidence?

  @@index([cameraId, type, time])
  @@index([time])
}

model Interval {
  id            String    @id // ses_…
  cameraId      String
  camera        Camera    @relation(fields: [cameraId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  useCase       String
  kind          String
  subjectId     String?
  start         DateTime  @db.Timestamptz(3)
  end           DateTime? @db.Timestamptz(3)
  endReason     String?
  configVersion Int?
  schemaVersion Int
  data          Json

  @@index([cameraId, kind, start])
}

model Metric {
  cameraId String
  camera   Camera   @relation(fields: [cameraId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  useCase  String
  name     String
  minute   DateTime @db.Timestamptz(3)
  value    Float

  @@id([cameraId, name, minute])
}

model DeadEvent {
  id        BigInt   @id @default(autoincrement())
  streamId  String
  payload   String // raw msg
  reason    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

enum ModelFormat {
  ONNX
  PT
  ENGINE
}

enum ModelSource {
  BUILTIN
  FILESYSTEM
  UPLOAD
  CONVERTED
}

enum ModelStatus {
  UPLOADED
  VALIDATING
  READY
  FAILED
  CONVERTING
}

model AiModel {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  version         String?
  format          ModelFormat
  source          ModelSource
  status          ModelStatus
  filePath        String      @unique // relative to MODELS_DIR, "/" separators
  originalName    String
  sha256          String?     @unique // null only while CONVERTING
  sizeBytes       BigInt?
  classNames      Json? // string[] after validation
  validation      Json? // { ok, latencyMs?, device?, error?, at }
  convertedFromId String?     @db.Uuid
  createdById     String?     @db.Uuid
  notes           String?
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)
}

/// One row (id = 1, enforced by a CHECK): the site's name, time zone and retention defaults.
model SiteSettings {
  id                         Int      @id @default(1)
  siteName                   String
  timeZone                   String
  recordingRetentionDays     Int
  snapshotRetentionDays      Int
  auditSnapshotRetentionDays Int
  evidenceRetentionDays      Int
  updatedAt                  DateTime @updatedAt @db.Timestamptz(3)
}

enum EvidenceReason {
  SEVERITY
  AUDIT_CAMERA
  USER
}

enum EvidenceStatus {
  QUEUED
  KEPT
  NO_RECORDING
  FAILED
}

/// A clip kept past the continuous recording; also protects the event's snapshot from retention.
model Evidence {
  eventId   String         @id
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cameraId  String
  eventTime DateTime       @db.Timestamptz(3)
  reason    EvidenceReason
  status    EvidenceStatus @default(QUEUED)
  runAt     DateTime       @db.Timestamptz(3)
  attempts  Int            @default(0)
  error     String?
  filePath  String? // relative to EVIDENCE_DIR
  sizeBytes Int?
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  @@index([status, runAt])
  @@index([cameraId, eventTime])
}

enum ExportStatus {
  QUEUED
  DONE
  FAILED
  EXPIRED
}

model ExportJob {
  id            String       @id @default(uuid()) @db.Uuid
  params        Json
  status        ExportStatus @default(QUEUED)
  runAt         DateTime     @default(now()) @db.Timestamptz(3)
  attempts      Int          @default(0)
  error         String?
  filePath      String? // relative to EXPORTS_DIR
  sizeBytes     Int?
  finishedAt    DateTime?    @db.Timestamptz(3)
  createdById   String
  createdByName String
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
}
