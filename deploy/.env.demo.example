# For the frontend team: the whole backend without a GPU or a camera. Copy to deploy/.env, then
#   docker compose up -d --build
# See docs/fe-dev-setup.md.
#
# EVERY SECRET BELOW IS FIXED AND PUBLIC. NEVER USE THIS FILE ON A REAL SITE.
ZOO_DATA_DIR=./data
ZOO_VERSION=dev

# demo = demo-seed (cameras and users) and demo-feed (history, live status, frames)
COMPOSE_PROFILES=demo

POSTGRES_PASSWORD=demo-only-postgres-pw
ZOO_API_DB_PASSWORD=demo-only-api-db-pw
REDIS_PASSWORD=demo-only-redis-pw
# base64 of 32 bytes (the characters 0..31). Never on a real site.
CAMERA_URL_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
ENGINE_TOKEN=demo-only-engine-token-0123456789abcdef0123456789abcdef
# Only compose's interpolation reads it in the demo profile (no MediaMTX runs).
MEDIAMTX_PASSWORD=demo-only-mediamtx-pw-0123456789

# Open the dashboard at http://localhost:8080 (never :3000: cookies and the WebSocket do not work there).
# Caddy sends everything that is not /api, /media or /ws to `npm run dev` on your machine.
# Caddy listens on this machine only: the demo logins and secrets in this file are public, so other
# machines on your network must not reach the stack. 0.0.0.0 (all interfaces) only to show it to a colleague.
ZOO_BIND_ADDR=127.0.0.1
ZOO_HTTP_PORT=8080
ZOO_CADDY_MODE=dev
ZOO_WEB_UPSTREAM=host.docker.internal:3000
ZOO_COOKIE_SECURE=false
ZOO_SWAGGER=public

# The demo profile has no MediaMTX: no path sync, no clips, no live video
ZOO_MEDIAMTX_API_URL=
ZOO_MEDIAMTX_PLAYBACK_URL=

# demo-seed refuses to run unless this is on, so known-password users cannot appear on a real site by accident
ZOO_DEMO=on
# the password of demo-superadmin, demo-manager and demo-user (at least 10 characters)
DEMO_PASSWORD=demo-only-password-123
