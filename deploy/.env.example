# Copy to deploy/.env (git-ignored). Host folder for recordings, snapshots, models, certs and logs.
ZOO_DATA_DIR=./data
# Image tag of the API, the engine and the dashboard
ZOO_VERSION=dev

# Which optional services start (comma separated): engine = mediamtx + the GPU engine, web = the dashboard,
# demo = fake cameras, users and history for development without a GPU.
# A park server: engine,web. A laptop without a GPU: leave it empty (or demo).
COMPOSE_PROFILES=engine,web
# Prefix of the container, network and volume names. Keep one value per stack on a shared server.
# COMPOSE_PROJECT_NAME=zoo-vision

# Secrets: generate each one, never reuse them. Do not commit deploy/.env.
# Passwords go into connection URLs, so use URL-safe characters: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
ZOO_API_DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
# base64 of 32 random bytes: openssl rand -base64 32
# Back this up together with the database: without it every stored stream URL is unreadable.
CAMERA_URL_KEY=change-me
# openssl rand -hex 32. The API and the engine share it.
ENGINE_TOKEN=change-me
# The password of MediaMTX's user `zoo`, used by the API (path sync, clips), the engine (RTSP) and Caddy (WebRTC).
# openssl rand -hex 24. 12 characters or more. Nothing on the LAN reaches video without it.
MEDIAMTX_PASSWORD=change-me

# --- Host ports. Change one when it is already taken on this machine. ---
# The host address Caddy's ports are published on: 0.0.0.0 = every interface (a park server);
# 127.0.0.1 = this machine only (a development stack)
ZOO_BIND_ADDR=0.0.0.0
# Caddy, http and https (the only ports other machines need)
ZOO_HTTP_PORT=80
ZOO_HTTPS_PORT=443
# The API on 127.0.0.1, for the engine running from source and for debugging
ZOO_API_PORT=3001
# Redis on 127.0.0.1, for the host-networked engine. Change it when 6379 is already taken.
ZOO_REDIS_PORT=6379
# Postgres admin access on 127.0.0.1, used only with docker-compose.override.yml
ZOO_PG_PORT=5433

# --- Caddy ---
# dev = plain http on ZOO_HTTP_PORT (development only)
# internal-tls = Caddy's own CA signs a certificate for ZOO_SITE_ADDRESS (park PCs install its root once)
# custom-tls = the customer's ${ZOO_DATA_DIR}/certs/cert.pem and key.pem
ZOO_CADDY_MODE=internal-tls
# The name or IP address the dashboard is opened at (internal-tls and custom-tls)
ZOO_SITE_ADDRESS=localhost
# Where Caddy sends everything that is not /api, /media or /ws. The web service by default;
# in development, `next dev` on the host: host.docker.internal:3000
ZOO_WEB_UPSTREAM=web:3000
# Where Caddy sends the browser's WHEP calls (/media/webrtc/*): MediaMTX's WebRTC HTTP port, on the host
ZOO_MEDIAMTX_WEBRTC_UPSTREAM=host.docker.internal:8889
# Folder of the frontend checkout the web service is built from
ZOO_WEB_DIR=../../zoo-vision-fe

# --- The API ---
# true on a real site (https). false only for plain http in development, or the login cookie is dropped.
ZOO_COOKIE_SECURE=true
# off | superadmin (docs for a logged-in superadmin or a superadmin API token) | public (development only)
ZOO_SWAGGER=off
# Where the API asks for event clips. The default reaches MediaMTX of the engine profile (host network, :9996).
# Set but empty: clips answer RECORDING_NOT_AVAILABLE. The API logs a warning when playback is unreachable.
ZOO_MEDIAMTX_PLAYBACK_URL=http://host.docker.internal:9996
# Where the API reaches MediaMTX's Control API to keep the zv_* paths in sync. Set but empty: no sync and no
# live video (the demo profile). Needs MEDIAMTX_PASSWORD.
ZOO_MEDIAMTX_API_URL=http://host.docker.internal:9997
# Gotenberg prints the PDF reports (the compose service of that name). Set but empty: PDF export answers 503.
# ZOO_GOTENBERG_URL=http://gotenberg:3000

# docker compose exec -e ZOO_ADMIN_PASSWORD=<your password> api node dist/cli.js create-superadmin --username admin --name "Your Name"
