# Local-dev settings for the engine, read from services/engine/.env at start.
# Copy to .env and fill in. A variable already set in the real environment wins over this file.
# Never commit .env; it holds secrets. Full list: README.md "Run".

# Required. Redis from deploy/.env (ZOO_REDIS_PORT, REDIS_PASSWORD).
REDIS_URL=redis://:<redis-password>@127.0.0.1:6379/0
# Required, at least 32 characters; the same ENGINE_TOKEN as deploy/.env.
ENGINE_TOKEN=<engine-token>

API_URL=http://127.0.0.1:3001
ENGINE_GROUP=default
DEVICE=cpu
# The models folder the API manages (relative to services/engine).
ZOO_MODELS_DIR=../../deploy/data/models
# Keep off on a weak laptop until you need validation or conversion jobs.
ENGINE_MODEL_JOBS=off

# Only if the dashboard sets AI_ENGINE_API_KEY (zoo-vision-fe .env.local).
# PREVIEW_API_KEY=
